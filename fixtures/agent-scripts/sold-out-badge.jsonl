# 3턴 — 별의 폴더 안에서 요구사항(품절 배지)을 구현한다.
{"kind":"patch","files":[{"path":"src/components/shop/NebulaProbe/useNebulaProbe.ts","content":"import { useCallback, useState } from 'react';\n\nexport interface INebulaProbeItem {\n  id: string;\n  label: string;\n  /** 품절이면 true. 품절 배지를 띄울지 결정한다. */\n  isSoldOut: boolean;\n}\n\nexport interface IUseNebulaProbe {\n  isLoading: boolean;\n  hasError: boolean;\n  items: INebulaProbeItem[];\n  selectedId: string | null;\n  selectItem: (id: string) => void;\n}\n\n/**\n * NebulaProbe 의 상태와 행동.\n *\n * ⚠️ props 를 여기 복사하지 마라 — 파생값은 렌더 중 계산한다(평탄성·품질 법칙).\n */\nexport const useNebulaProbe = (): IUseNebulaProbe => {\n  const [selectedId, setSelectedId] = useState<string | null>(null);\n\n  /* TODO: 실제 데이터 소스로 바꾼다. 지금은 별이 도는지 보기 위한 최소값이다. */\n  const loadedItems: INebulaProbeItem[] = [];\n\n  const selectItem = useCallback((id: string) => {\n    setSelectedId(id);\n  }, []);\n\n  return { isLoading: false, hasError: false, items: loadedItems, selectedId, selectItem };\n};\n"},{"path":"src/components/shop/NebulaProbe/NebulaProbe.tsx","content":"import { useNebulaProbe } from './useNebulaProbe';\n\ninterface INebulaProbeProps {\n  /** 별에 들어오는 것. 필요 없으면 이 인터페이스째 지운다. */\n  title?: string;\n}\n\nexport const NebulaProbe = ({ title = 'NebulaProbe' }: INebulaProbeProps) => {\n  const { isLoading, hasError, items, selectItem } = useNebulaProbe();\n\n  if (hasError) {\n    return (\n      <section role=\"alert\" className=\"text-destructive p-4\">\n        불러오지 못했습니다.\n      </section>\n    );\n  }\n\n  if (isLoading) {\n    return <section className=\"text-muted-foreground p-4\">불러오는 중…</section>;\n  }\n\n  return (\n    <section aria-label={title} className=\"flex flex-col gap-4 p-4\">\n      <h2 className=\"text-foreground text-lg font-semibold\">{title}</h2>\n      <ul className=\"flex flex-col gap-2\">\n        {items.map((item) => (\n          <li key={item.id}>\n            <button\n              type=\"button\"\n              onClick={() => selectItem(item.id)}\n              disabled={item.isSoldOut}\n              className=\"bg-background hover:bg-accent flex w-full items-center gap-2 rounded-md border p-3 text-left\"\n            >\n              <span>{item.label}</span>\n              {item.isSoldOut ? (\n                <span className=\"bg-muted text-muted-foreground rounded px-2 py-0.5 text-xs\">품절</span>\n              ) : null}\n            </button>\n          </li>\n        ))}\n      </ul>\n    </section>\n  );\n};\n"}],"note":"항목에 isSoldOut 을 두고 품절이면 배지를 띄우며 버튼을 막는다"}

