// 은하 좌표 예시 — `galaxies/{이름}.json` 으로 복사해 채운다.
// ⚠️ 이 파일은 예시다. 실제 은하는 **배달되지 않는다**(보존 법칙) — 소비 저장소가 자기 것을 만든다.
{
  "name": "my-app",
  "description": "한 줄 설명.",

  // 저장소 절대경로. 관측이 여기서 커밋 SHA 를 읽는다.
  "path": "/absolute/path/to/my-app",

  // 모노레포가 아니면 appWorkspace 는 "", appDir 은 "." 이다.
  "appWorkspace": "@acme/app-web",
  "appDir": "apps/web",

  // 이 은하에서 켤 법칙. ⚠️ `form` 은 opt-in — 팀 합의가 있을 때만 켠다.
  "laws": ["tokens", "semantics", "naming", "flatness", "cohesion"],

  // 은하의 **기존** 명령 이름. 우주는 은하의 코드를 고치지 않는다.
  // ⛔ 파이프를 쓰지 마라 — 파이프 뒤 종료코드는 마지막 명령의 것이라 실패가 0으로 보인다.
  "commands": {
    "build": "yarn build",
    "test": "yarn test:run",
    "lintJson": "yarn workspace <WORKSPACE> exec eslint <TARGET> --report-unused-disable-directives --format json -o <OUT>",
    "testFile": "yarn workspace @acme/app-web exec vitest run <PATH> --reporter=basic",
    "extraGates": { "typecheck": "yarn typecheck" },

    // 2차 팽창의 자가 수정이 쓴다. `<TARGET>` 이 **별의 폴더**로 치환된다.
    // ⚠️ 없으면 자가 수정을 포기하고 인계한다 — 잘못된 경로에 --fix 를 걸지 않기 위해서다.
    "lintFix": "yarn workspace <WORKSPACE> exec eslint <TARGET> --fix"
  },

  // 게이트 통과 조건 = 여기 전부 0 error.
  // ⚠️ 앱만 넣고 공유 패키지를 빼면, 별이 그것을 망가뜨려도 초록불이 난다.
  // ⛔ 이제 **경고가 아니라 관문**이다(R70) — 앱이 쓰는 워크스페이스 패키지가 여기 없으면
  //    `universe observe` 가 멈춘다. 이 은하의 몫이 아니면 아래처럼 적어라:
  //      "sharedPackagesJudged": { "@acme/ui": "다른 팀이 재는 패키지다" }
  "lintTargets": [
    { "workspace": "@acme/app-web", "target": "./src" },
    { "workspace": "@acme/ui", "target": "./src" }
  ],

  // 규칙이 못 읽는 코드에 대한 **판단**. 규칙은 `.ts`·`.tsx` 만 읽는다.
  // ⚠️ 적기 전에는 `universe observe` 가 초록불을 주지 않는다 — 안 재진 것을
  //    「위반 없음」으로 읽는 것이 0건보다 위험하기 때문이다(관측 법칙 §8).
  "blindJudged": {
    ".js": "설정 파일뿐이라 화면 규칙의 대상이 아니다",
    ".vue": "이 저장소는 Vue 다 — 지금 규칙은 못 읽는다. 재려면 규칙을 Vue 로 넓혀야 한다"
  },

  // 광속 한계 — 깨끗한 상태의 실측값 이상이어야 한다.
  "thresholds": { "initialLoadKB": 1700 },

  // 태양계 = 하나의 중력에 묶인 기능 묶음. 별이 그 안에서 태어난다.
  "solarSystems": [
    { "name": "dashboard", "description": "통계 화면 묶음", "srcDir": "src/components/pages/dashboard" }
  ]

  // observed 는 적지 마라 — `universe observe --update` 가 채운다.
  // commit · dirtyFiles · fingerprint · laws 가 함께 기록된다.
}
