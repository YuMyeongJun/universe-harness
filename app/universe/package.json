{
  "name": "@qa-harness/knowledge-console",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "도메인 지식 실측 콘솔 — 사람이 클릭으로 수집·교정하고 지식 md 를 낸다",
  "scripts": {
    "dev": "npm run build:server && concurrently -k -n server,web -c blue,magenta \"npm run dev:server\" \"npm run dev:web\"",
    "dev:server": "concurrently -k -n tsc,node -c yellow,blue \"tsc -p tsconfig.server.json --watch --preserveWatchOutput\" \"node --watch dist/index.js\"",
    "dev:web": "vite",
    "build:server": "tsc -p tsconfig.server.json",
    "typecheck": "tsc -p tsconfig.server.json --noEmit && tsc -p web/tsconfig.json --noEmit",
    "postinstall": "playwright install chromium --with-deps || playwright install chromium || true",
    "predev": "node scripts/free-ports.mjs",
    "free-ports": "node scripts/free-ports.mjs"
  },
  "dependencies": {
    "express": "^4.21.2",
    "playwright": "^1.48.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.0",
    "typescript": "^5.6.0",
    "vite": "^6.0.3"
  }
}
