{
  "name": "@core/fe-agent-contracts",
  "version": "0.1.0",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "description": "토스 표준 기반 프론트엔드 공통 계약(코드 퀄리티·A11y·Tailwind 토큰)과 WikiSkill 추출 프로토콜. 규칙과 프롬프트만 있고 실행 루프는 없다.",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./prompts/contract": "./dist/prompts/CONTRACT_SYSTEM_PROMPT.md",
    "./prompts/extract": "./dist/prompts/EXTRACT_PROMPT.md"
  },
  "engines": {
    "node": ">=22.6"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node ../../../scripts/copy-assets.mjs",
    "typecheck": "tsc -p tsconfig.json",
    "selftest": "node src/selftest.ts",
    "prepack": "npm run build"
  },
  "peerDependencies": {
    "@core/fe-agent-harness": "^0.1.0"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ]
}
