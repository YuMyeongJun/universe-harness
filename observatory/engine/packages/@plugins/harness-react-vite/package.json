{
  "name": "@plugins/harness-react-vite",
  "version": "0.1.0",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "description": "React + Vite + AWS(S3/CloudFront) 특화 EnvHarness 플러그인. 코어를 상속해 게이트·배포 시뮬레이션·Stage 01~04 를 채운다.",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "bin": {
    "fe-harness": "./dist/cli.js",
    "fe-harness-wiki": "./dist/wiki.js"
  },
  "engines": {
    "node": ">=22.6"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node ../../../scripts/copy-assets.mjs && chmod +x dist/cli.js dist/wiki.js",
    "typecheck": "tsc -p tsconfig.json",
    "selftest": "node src/selftest.ts",
    "prepack": "npm run build"
  },
  "peerDependencies": {
    "@core/fe-agent-contracts": "^0.1.0",
    "@core/fe-agent-harness": "^0.1.0"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ]
}
