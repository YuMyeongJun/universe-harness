{
  "name": "@plugins/harness-next",
  "version": "0.1.0",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "description": "Next.js(App Router) 특화 EnvHarness 플러그인. PluggableHarness 에 게이트와 스테이지를 주입한다 — 배포 시뮬레이터는 없다(Next 배포는 스택마다 다르다).",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "bin": {
    "next-harness": "./dist/cli.js"
  },
  "engines": {
    "node": ">=22.6"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node ../../../scripts/copy-assets.mjs && chmod +x dist/cli.js",
    "typecheck": "tsc -p tsconfig.json",
    "selftest": "node src/selftest.ts",
    "prepack": "npm run build"
  },
  "peerDependencies": {
    "@core/fe-agent-contracts": "^0.1.0",
    "@core/fe-agent-harness": "^0.1.0"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ]
}
