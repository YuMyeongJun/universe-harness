{
  "name": "universe-observatory-engine",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "\uad00\uce21\uc18c\uc758 \uc5d4\uc9c4 \u2014 fe-agent-harness 3\ud328\ud0a4\uc9c0\ub97c \uc6b0\uc8fc \uc548\uc73c\ub85c \ubca4\ub354\ub9c1\ud55c \uac83. \uc6b0\uc8fc\uac00 \uc678\ubd80 \uc808\ub300\uacbd\ub85c \uc5c6\uc774 \ud63c\uc790 \ub3cc\uac8c \ud55c\ub2e4(\ubcf4\uc874 \ubc95\uce59: \uc0b0\ucd9c\ubb3c\uc774\uc9c0 \uc790\uc0b0\uc774 \uc544\ub2c8\ub2e4).",
