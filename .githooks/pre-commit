#!/usr/bin/env bash
#
# 커밋 시점 관문 — 빠른 것만 건다.
#
# ⚠️ 왜 있는가: 관문이 `round close` 에만 있어서 **죽은 규칙이 HEAD 에 들어간 적이 있다.**
# `a11y/img-alt` 의 패턴에 `NEVERMATCH` 가 커밋됐고, 그것을 재는 시험이 그때는 없어
# 며칠이든 초록불로 살 수 있는 상태였다. 라운드를 닫을 때 잡는 것은 **늦다.**
#
# 여기 거는 것은 **1초 남짓에 끝나는 것만**이다(실측: 우주 형식 891ms · 엔진 계약 78ms ·
# 행동 계약 36ms · 문서 링크 33ms). 느린 것(변이 시험 · 관측 · 엔진 빌드)은 걸지 않는다 —
# 커밋마다 20초를 물리면 사람이 `--no-verify` 를 습관으로 만들고, 그러면 관문이 장식이 된다.
#
# ⚠️ **없는 검사는 건너뛰고 그렇게 말한다.** 소비 저장소에는 엔진이 배달되지 않으므로
# (`universe init` 의 EXCLUDE) 엔진 시험이 없다. 없는 것을 실패로 세면 관문이 늘 빨갛고,
# 조용히 빼면 「몇 개가 돌았는지」를 속인다 — 관측 법칙 §8.
#
# 켜는 법:  universe hooks --install     (= git config core.hooksPath .githooks)
# 끄는 법:  git commit --no-verify        (급할 때. 다만 round close 가 다시 문다)
#
# ⛔ 파이프 뒤에서 종료코드를 읽지 마라(관측 법칙 §3).
set -uo pipefail

REPO="$(git rev-parse --show-toplevel)"
cd "$REPO" || exit 1

# 우주의 집을 찾는다 — 저장소 루트일 수도, `universe/` 같은 하위일 수도 있다.
HOME_DIR=""
for candidate in "." ./*/; do
  if [ -f "${candidate%/}/universe.config.json" ]; then
    HOME_DIR="${candidate%/}"
    break
  fi
done
if [ -z "$HOME_DIR" ]; then
  printf '🛡  커밋 관문 — universe.config.json 을 못 찾았다. 건너뛴다.\n'
  exit 0
fi

fail=0
ran=0
skipped=0

run() {
  local label="$1" target="$2"; shift 2
  if [ ! -e "$target" ]; then
    printf '  ⏭  %s (없다 — 배달되지 않는 것)\n' "$label"
    skipped=$((skipped + 1))
    return
  fi
  ran=$((ran + 1))
  local out
  out="$("$@" 2>&1)"
  local code=$?
  # ⚠️ 의존이 없어 죽은 것은 **실패가 아니라 못 돈 것**이다. 엔진은 일부러 배달하지
  #    않으므로(패키지가 준다) 소비 저장소에서 엔진 시험은 여기서 못 돈다.
  #    이걸 실패로 세면 관문이 늘 빨갛고, 조용히 빼면 몇 개가 돌았는지를 속인다.
  if [ "$code" -ne 0 ] && printf '%s' "$out" | grep -q 'ERR_MODULE_NOT_FOUND'; then
    printf '  ⏭  %s (의존이 없다 — 엔진 미설치)\n' "$label"
    ran=$((ran - 1))
    skipped=$((skipped + 1))
    return
  fi
  if [ "$code" -ne 0 ]; then
    printf '  ❌ %s  exit=%s\n' "$label" "$code"
    printf '%s\n' "$out" | tail -12 | sed 's/^/     /'
    fail=1
  else
    printf '  ✅ %s\n' "$label"
  fi
}

HOOK_STARTED=$(date +%s%N)
printf '🛡  커밋 관문 — 빠른 것만 (%s)\n' "$HOME_DIR"

ENGINE_SELFTEST="$HOME_DIR/observatory/engine/packages/@core/fe-agent-contracts/src/selftest.ts"

run '부품 시험'      "$HOME_DIR/lib/selftest.mjs"             node "$HOME_DIR/lib/selftest.mjs"
run '우주 형식'      "$HOME_DIR/observatory/verify-laws.sh"   bash "$HOME_DIR/observatory/verify-laws.sh"
run '문서 링크'      "$HOME_DIR/observatory/verify-links.mjs" node "$HOME_DIR/observatory/verify-links.mjs"
run '엔진 계약 규칙' "$ENGINE_SELFTEST"                        node "$ENGINE_SELFTEST"
run '행동 계약 보호' "$HOME_DIR/bigbang/selftest-behavior-contract.mjs" node "$HOME_DIR/bigbang/selftest-behavior-contract.mjs"

if [ "$fail" -ne 0 ]; then
  printf '\n⛔ 커밋을 막는다. 고치고 다시 커밋하라.\n'
  printf '   정말 급하면 `git commit --no-verify` — 다만 `universe round close` 가 다시 문다.\n'
  exit 1
fi

if [ "$ran" -eq 0 ]; then
  printf '\n⛔ 돈 검사가 0개다 — 통과가 아니라 **관문이 아무것도 못 찾은 것**이다(관측 법칙 §8).\n'
  exit 1
fi

# ⛔ **시간을 손으로 적으면 낡는다(R118).** 문서에 「1.5초」로 적혀 있었는데 실측은 2.8초였다 —
#    같은 관문 다섯인데 검사가 무거워진 것이다. 훅이 스스로 재서 말한다.
elapsed=$(( ($(date +%s%N) - HOOK_STARTED) / 1000000 ))
printf '\n✅ 통과 — %s개 돌았고 %s개는 없어서 건너뛰었다. (%sms)\n' "$ran" "$skipped" "$elapsed"
printf '   (느린 것은 여기 없다 — `universe checks` 와 `round close` 가 본다)\n'
