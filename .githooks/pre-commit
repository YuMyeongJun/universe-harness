#!/usr/bin/env bash
#
# 커밋 시점 관문 — 빠른 것만 건다.
#
# ⚠️ 왜 있는가: 관문이 `round close` 에만 있어서 **죽은 규칙이 HEAD 에 들어간 적이 있다.**
# `a11y/img-alt` 의 패턴에 `NEVERMATCH` 가 커밋됐고, 그것을 재는 시험이 그때는 없어
# 며칠이든 초록불로 살 수 있는 상태였다. 라운드를 닫을 때 잡는 것은 **늦다.**
#
# 여기 거는 것은 **1초 남짓에 끝나는 것만**이다(실측: 우주 형식 891ms · 엔진 계약 78ms ·
# 행동 계약 36ms · 문서 링크 33ms). 느린 것(변이 시험 · 관측 · 엔진 빌드)은 걸지 않는다 —
# 커밋마다 20초를 물리면 사람이 `--no-verify` 를 습관으로 만들고, 그러면 관문이 장식이 된다.
#
# ⚠️ **없는 검사는 건너뛰고 그렇게 말한다.** 소비 저장소에는 엔진이 배달되지 않으므로
# (`universe init` 의 EXCLUDE) 엔진 시험이 없다. 없는 것을 실패로 세면 관문이 늘 빨갛고,
# 조용히 빼면 「몇 개가 돌았는지」를 속인다 — 관측 법칙 §8.
#
# 켜는 법:  universe hooks --install     (= git config core.hooksPath .githooks)
# 끄는 법:  git commit --no-verify        (급할 때. 다만 round close 가 다시 문다)
#
# ⛔ 파이프 뒤에서 종료코드를 읽지 마라(관측 법칙 §3).
set -uo pipefail

REPO="$(git rev-parse --show-toplevel)"
cd "$REPO" || exit 1

# 우주의 집을 찾는다 — 저장소 루트일 수도, `universe/` 같은 하위일 수도 있다.
HOME_DIR=""
for candidate in "." ./*/; do
  if [ -f "${candidate%/}/universe.config.json" ]; then
    HOME_DIR="${candidate%/}"
    break
  fi
done
if [ -z "$HOME_DIR" ]; then
  printf '🛡  커밋 관문 — universe.config.json 을 못 찾았다. 건너뛴다.\n'
  exit 0
fi

fail=0
ran=0
skipped=0

run() {
  local label="$1" target="$2"; shift 2
  if [ ! -e "$target" ]; then
    printf '  ⏭  %s (없다 — 배달되지 않는 것)\n' "$label"
    skipped=$((skipped + 1))
    return
  fi
  ran=$((ran + 1))
  local out
  out="$("$@" 2>&1)"
  local code=$?
  # ⚠️ 의존이 없어 죽은 것은 **실패가 아니라 못 돈 것**이다. 엔진은 일부러 배달하지
  #    않으므로(패키지가 준다) 소비 저장소에서 엔진 시험은 여기서 못 돈다.
  #    이걸 실패로 세면 관문이 늘 빨갛고, 조용히 빼면 몇 개가 돌았는지를 속인다.
  if [ "$code" -ne 0 ] && printf '%s' "$out" | grep -q 'ERR_MODULE_NOT_FOUND'; then
    printf '  ⏭  %s (의존이 없다 — 엔진 미설치)\n' "$label"
    ran=$((ran - 1))
    skipped=$((skipped + 1))
    return
  fi
  if [ "$code" -ne 0 ]; then
    printf '  ❌ %s  exit=%s\n' "$label" "$code"
    printf '%s\n' "$out" | tail -12 | sed 's/^/     /'
    fail=1
  else
    printf '  ✅ %s\n' "$label"
  fi
}

HOOK_STARTED=$(date +%s%N)
printf '🛡  커밋 관문 — 빠른 것만 (%s)\n' "$HOME_DIR"

ENGINE_SELFTEST="$HOME_DIR/observatory/engine/packages/@core/fe-agent-contracts/src/selftest.ts"

# ⛔⛔ **이 은하의 코드가 나빠졌는가** — 소비 저장소에서 이 관문의 존재 이유다.
#    ⚠️⚠️ 실측(2026-09-08): 여기 `observe` 가 **없어서**, 우주를 깔고 훅까지 켠 저장소에서
#    위반이 6건 늘어난 커밋이 관문을 **그냥 지나갔다.** 관문 다섯이 전부 「우주가 멀쩡한가」만
#    보고 있었고 **「당신 코드가 나빠졌는가」는 아무도 안 봤다.**
#    ⛔ 느려서 뺀 것이 아니다 — 진짜 은하(1,407파일)에서 **0.73초**다(실측).
# ⛔⛔ **깔린 폴더의 사본으로 부르면 안 된다 — 거기엔 엔진이 없다.**
#    엔진은 배달되지 않고 **패키지가 들고 온다**(`lib/gates.mjs` 의 `runsFrom: 'package'`).
#    실측(2026-09-08): `$HOME_DIR/observatory/observe.mjs` 를 직접 불렀더니
#    「관측 엔진을 찾지 못했다」로 죽었다 — 도구가 그 사유를 정확히 말해 줬다.
#    ⇒ **패키지의 CLI** 를 찾아 그 폴더를 겨눈다. 못 찾으면 ⏭ 로 물러난다(거짓 초록보다 낫다).
# ⛔⛔ **아래 세 자리의 `universe` 는 전부 「명령 이름」이다 — 패키지 이름이 아니다.**
#    npm 패키지 이름은 `universe-front-harness` 이지만 `package.json` 의 `bin` **키**는 `universe` 라서
#    깔리는 파일은 `node_modules/.bin/universe` 이고 PATH 에 놓이는 것도 `universe` 다.
#    ⚠️ 여기를 `universe-front-harness` 로 바꾸면 **훅이 CLI 를 영영 못 찾는다** — 그러면 아래
#    「못 찾으면 막는다」 갈래에 걸려 **이 저장소의 모든 커밋이 막힌다.** 바꾸지 마라.
OBSERVE_CLI=""
if [ -x "$REPO/node_modules/.bin/universe" ]; then
  OBSERVE_CLI="$REPO/node_modules/.bin/universe"      # 소비 저장소 — 깔린 패키지
elif [ -f "$HOME_DIR/bin/universe.mjs" ]; then
  OBSERVE_CLI="$HOME_DIR/bin/universe.mjs"            # 우주 저장소 자신
elif command -v universe >/dev/null 2>&1; then
  # ⚠️ 전역 설치(`npm i -g` · `npm link`). 저장소마다 패키지 매니저가 다르므로
  #    `node_modules` 에 있다고 **전제하지 않는다** — yarn berry · pnpm 배치가 실제로 있다.
  OBSERVE_CLI="$(command -v universe)"
fi
# ⛔⛔ **못 찾으면 건너뛰지 않고 막는다 — 여기서 ⏭ 는 거짓 초록이다.**
#    ⚠️ 다른 검사의 ⏭ 는 「그 부품이 배달되지 않았다」는 뜻이라 정직하다. 그런데 이 검사가
#    ⏭ 로 넘어가면 **「당신 코드가 나빠졌는가」를 아무도 안 본 채 커밋이 통과한다.**
#    ⛔ 안 잰 것이 통과로 보이는 자리를 만들지 않는다(관측 법칙 §8).
#    ⚠️ 실측 배경: 저장소마다 패키지 매니저가 다르다(yarn berry · pnpm · 전역 설치).
#    `node_modules/.bin/universe` 가 없는 배치가 실제로 있다.
if [ -z "$OBSERVE_CLI" ]; then
  printf '  ⛔ %s — 우주 CLI 를 못 찾았다. **재지 못했다**(통과가 아니다).\n' '법칙 관측'
  printf '     찾아본 자리: %s · %s\n' "$REPO/node_modules/.bin/universe" "$HOME_DIR/bin/universe.mjs"
  printf '     ⇒ 이 저장소의 패키지 매니저로 우주를 깔거나, 전역 설치면 PATH 의 것을 쓰도록 훅을 고쳐라.\n'
  fail=1
else
  run '법칙 관측'    "$OBSERVE_CLI"                          "$OBSERVE_CLI" observe --universe "$HOME_DIR"
fi
# ⚠️⚠️ **표적이 `lib/selftest.mjs` 가 아니라 `observatory/verify-checks.mjs` 다 — 일부러 그렇다.**
#    부품 시험은 우주 **자신의 소스**를 읽는다(변이 케이스가 `expect:` 를 적었는지 등). 그 소스는
#    배달되지 않으므로 소비 저장소에서는 `ENOENT` 로 죽는다. 실측(2026-09-08): 그래서 갓 깐
#    저장소에서 **모든 커밋이** 자기 코드와 무관한 크래시로 막혔다 — R58 이 경고한 바로 그 모양이고,
#    그걸 본 사람은 관문을 끄는 법부터 배운다. ⇒ **읽을 대상이 있을 때만** 돈다(우주 저장소).
run '부품 시험'      "$HOME_DIR/observatory/verify-checks.mjs" node "$HOME_DIR/lib/selftest.mjs"
run '우주 형식'      "$HOME_DIR/observatory/verify-laws.sh"   bash "$HOME_DIR/observatory/verify-laws.sh"
run '문서 링크'      "$HOME_DIR/observatory/verify-links.mjs" node "$HOME_DIR/observatory/verify-links.mjs"
run '엔진 계약 규칙' "$ENGINE_SELFTEST"                        node "$ENGINE_SELFTEST"
run '행동 계약 보호' "$HOME_DIR/bigbang/selftest-behavior-contract.mjs" node "$HOME_DIR/bigbang/selftest-behavior-contract.mjs"

if [ "$fail" -ne 0 ]; then
  printf '\n⛔ 커밋을 막는다. 고치고 다시 커밋하라.\n'
  printf '   정말 급하면 `git commit --no-verify` — 다만 `universe round close` 가 다시 문다.\n'
  exit 1
fi

if [ "$ran" -eq 0 ]; then
  printf '\n⛔ 돈 검사가 0개다 — 통과가 아니라 **관문이 아무것도 못 찾은 것**이다(관측 법칙 §8).\n'
  exit 1
fi

# ⛔ **시간을 손으로 적으면 낡는다(R118).** 문서에 「1.5초」로 적혀 있었는데 실측은 2.8초였다 —
#    같은 관문 다섯인데 검사가 무거워진 것이다. 훅이 스스로 재서 말한다.
elapsed=$(( ($(date +%s%N) - HOOK_STARTED) / 1000000 ))
printf '\n✅ 통과 — %s개 돌았고 %s개는 없어서 건너뛰었다. (%sms)\n' "$ran" "$skipped" "$elapsed"
printf '   (느린 것은 여기 없다 — `universe checks` 와 `round close` 가 본다)\n'
